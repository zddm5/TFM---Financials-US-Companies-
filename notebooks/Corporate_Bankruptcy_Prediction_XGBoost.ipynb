    {
      "cell_type": "code",
      "source": [
        "# 4. ENTRENAR MODELO XGBOOST\n",
        "\n",
        "# Calculamos el peso para balancear\n",
        "ratio_balance = sum(y_train==0) / sum(y_train==1)\n",
        "\n",
        "# Configuramos el modelo\n",
        "model = xgb.XGBClassifier(\n",
        "    n_estimators=200,\n",
        "    learning_rate=0.1,     # Velocidad de aprendizaje\n",
        "    max_depth=6,           # Profundidad del análisis\n",
        "    scale_pos_weight=ratio_balance,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "print(\"MODELO ENTRENADO\")\n"
      ],
